FLASK_ENV=development
FLASK_APP=run.py
# Use SQLite for dev (leave blank to use default sqlite path)
# DATABASE_URL=postgresql://user:password@localhost:5432/sokomtaani
DATABASE_URL=sqlite:///sokomtaani_dev.db
# --- Production (Neon PostgreSQL) ---
# DATABASE_URL is the pooled (PgBouncer) URL for the app.
# DATABASE_URL_UNPOOLED is the direct URL for migrations and dumps.
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.aws-us-east-2.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.aws-us-east-2.aws.neon.tech/neondb?sslmode=require
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
CORS_ORIGINS=http://localhost:5173
LOW_MARGIN_THRESHOLD=0.10
